# Hamilog Backend Environment Configuration
# -------------------------------------------

# MongoDB connection string (not required — app falls back to in-memory DB)
MONGO_URI=mongodb://localhost:27017
DB_NAME=hamilog

# JWT signing secret — CHANGE THIS in production!
JWT_SECRET=hamilog-dev-secret-key-change-in-production

# OpenAI API key for cargo analysis (optional — falls back to regex parser)
OPENAI_API_KEY=sk-your-key-here

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
